{
  "sourceLanguage" : "de",
  "strings" : {
    "„~/.claude/settings.json“ ist kein gültiges JSON. Die App ändert die Datei deshalb nicht." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“~/.claude/settings.json” isn’t valid JSON, so the app doesn’t change it."
          }
        }
      }
    },
    "„claude“ kopieren" : {
