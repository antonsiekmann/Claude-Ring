    "Caches, gespeicherte Fensterzustände und Reste abgebrochener Updates" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "caches, saved window states and leftovers of interrupted updates"
